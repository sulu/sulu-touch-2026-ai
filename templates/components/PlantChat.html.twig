<section class="chat" {{ attributes }}>
    {% if not log and not question %}
        <p class="hint">Ask for a plant, for example: "Which plants are safe for cats and like shade?"</p>
    {% endif %}

    <div id="chat-log">
        {% for entry in log %}
            {% if 'plant' == entry.type %}
                <p class="plant"><a href="{{ entry.url }}">{{ entry.text }}</a></p>
            {% else %}
                <p class="{{ entry.type }}">{{ entry.text }}</p>
            {% endif %}
        {% endfor %}
    </div>

    <p class="thinking" data-loading>Thinking</p>

    {% if question %}
        <form class="ask" data-action="live#action:prevent" data-live-action-param="answer">
            <p class="agent">{{ question }}</p>
            {% for field in fields %}
                <label>{{ field.label }}
                    {% if 'select' == field.type %}
                        <select data-model="norender|answers[{{ field.name }}]">
                            {% for option in field.options|default([]) %}
                                <option value="{{ option.value ?? option.label ?? option }}">{{ option.label ?? option }}</option>
                            {% endfor %}
                        </select>
                    {% elseif 'checkbox' == field.type %}
                        <input type="checkbox" data-model="norender|answers[{{ field.name }}]">
                    {% else %}
                        <input type="text" data-model="norender|answers[{{ field.name }}]">
                    {% endif %}
                </label>
            {% endfor %}
            <button data-loading="addAttribute(disabled)">Send</button>
        </form>
    {% else %}
        <form class="send" data-action="live#action:prevent" data-live-action-param="send">
            <input name="message" data-model="norender|message" placeholder="Which plant fits my dark bathroom?" autocomplete="off" required>
            <button data-loading="addAttribute(disabled)">Ask</button>
        </form>
    {% endif %}
</section>
